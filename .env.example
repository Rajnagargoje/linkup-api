# Reference only: Spring does not automatically load this file.
# Configure these in AWS Elastic Beanstalk -> Configuration -> Updates, monitoring and logging -> Environment properties.
# Never commit real passwords, API keys, JWT secrets, or Firebase service-account JSON.
SPRING_PROFILES_ACTIVE=aws
PORT=8081
DATABASE_JDBC_URL=jdbc:postgresql://YOUR-NEON-POOLER-HOST/neondb?sslmode=require
DATABASE_USERNAME=YOUR_NEON_ROLE
DATABASE_PASSWORD=YOUR_NEON_PASSWORD
MONGODB_URI=mongodb+srv://USERNAME:ENCODED_PASSWORD@YOUR_CLUSTER/linkup?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_BASE64_OF_64_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_KEY
CLOUDINARY_API_SECRET=YOUR_SECRET
BREVO_API_KEY=YOUR_BREVO_API_KEY
MAIL_FROM=YOUR_VERIFIED_SENDER_EMAIL
FIREBASE_PROJECT_ID=linkup-7898e
LINKUP_PUSH_ENABLED=false
# When enabling Firebase Admin, point this to the service-account JSON path available inside the container.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
